---
import Layout from "../layouts/Layout.astro";
import ServiceList from "../components/services/ServiceList.astro";
import TechGrid from "../components/services/TechGrid.astro";
import HowIWork from "../components/services/HowIWork.astro";
import CTA from "../components/shared/CTA.astro";
---

<Layout title="Services | Miguel Figuera">
  <main>
    <!-- Page Header -->
    <section class="py-20 md:py-32">
      <div class="mx-auto max-w-6xl px-8 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
          Services
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
          End-to-end web development tailored to your business needs — from
          concept to deployment and beyond.
        </p>
      </div>
    </section>

    <ServiceList />
    <TechGrid />
    <HowIWork />
    <CTA />
  </main>
</Layout>
