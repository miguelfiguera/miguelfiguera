---
const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/products", label: "Products" },
];
---

<nav
  class="sticky top-0 z-50 hidden md:flex items-center justify-between bg-background border-b border-border px-8 py-3"
>
  <a href="/" class="flex items-center gap-2 text-foreground">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
    <span class="text-xl font-bold tracking-tight">Miguel Figuera</span>
  </a>

  <div class="flex items-center gap-8">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <a
    href="/#contact"
    class="rounded-md bg-silver px-4 py-2 text-sm font-medium text-black transition-all duration-300 hover:opacity-90 hover:shadow-lg"
  >
    Contact Me
  </a>
</nav>
