---
import { categories } from "../../data/products";
---

<aside data-erpnext-category="sidebar" class="w-full lg:w-64 shrink-0">
  <div class="rounded-xl border border-silver/10 bg-card p-6">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-muted-foreground">
      Categories
    </h3>
    <nav>
      <ul class="space-y-1">
        {categories.map((cat) => (
          <li>
            <button
              data-category-filter={cat === "All" ? "all" : cat.toLowerCase().replace(/\s+/g, "-")}
              class:list={[
                "w-full rounded-md px-3 py-2 text-left text-sm transition-colors category-btn",
                cat === "All"
                  ? "bg-silver/10 font-medium text-silver active"
                  : "text-muted-foreground hover:bg-silver/5 hover:text-foreground",
              ]}
            >
              {cat}
            </button>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<script>
  function initCategoryFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-category-filter]");
    const products = document.querySelectorAll<HTMLElement>("[data-product-category]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.categoryFilter;

        // Update active button
        buttons.forEach((b) => {
          b.classList.remove("bg-silver/10", "font-medium", "text-silver", "active");
          b.classList.add("text-muted-foreground");
        });
        btn.classList.add("bg-silver/10", "font-medium", "text-silver", "active");
        btn.classList.remove("text-muted-foreground");

        // Filter products
        products.forEach((product) => {
          if (filter === "all" || product.dataset.productCategory === filter) {
            product.style.display = "";
          } else {
            product.style.display = "none";
          }
        });
      });
    });
  }

  initCategoryFilter();
  document.addEventListener("astro:after-swap", initCategoryFilter);
</script>
