---
import { profile } from "../../data/profile";

const contactLinks = [
  {
    label: "Email",
    href: `mailto:${profile.email}`,
    description: profile.email,
    icon: "mail",
  },
  {
    label: "WhatsApp",
    href: profile.whatsapp,
    description: "Send a message",
    icon: "whatsapp",
  },
  {
    label: "LinkedIn",
    href: profile.linkedin,
    description: "Connect on LinkedIn",
    icon: "linkedin",
  },
];
---

<section id="contact" class="animate-on-scroll py-20 md:py-32">
  <div class="mx-auto max-w-6xl px-8">
    <!-- Badge -->
    <div class="flex justify-center">
      <span
        class="inline-flex items-center rounded-full border border-silver/30 bg-silver/10 px-4 py-1.5 text-sm font-medium text-silver"
      >
        Contact
      </span>
    </div>

    <!-- Heading -->
    <h2
      class="mt-6 text-center text-3xl font-bold tracking-tight md:text-4xl"
    >
      Get In Touch
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-muted-foreground">
      Have a project in mind or want to collaborate? Reach out through any of
      these channels.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <!-- Contact Form (Dolibarr CRM) -->
      <div class="rounded-xl border bg-card p-8 shadow">
        <h3 class="mb-6 text-lg font-semibold">Send a Message</h3>
        <form class="space-y-4" id="contact-form">
          <div>
            <label for="contact-name" class="mb-1.5 block text-sm font-medium">Name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              maxlength="200"
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="contact-email" class="mb-1.5 block text-sm font-medium">Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              maxlength="200"
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="your@email.com"
            />
          </div>
          <div>
            <label for="contact-phone" class="mb-1.5 block text-sm font-medium">
              Phone <span class="text-muted-foreground">(optional)</span>
            </label>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              maxlength="40"
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="+1 555 000 0000"
            />
          </div>
          <div>
            <label for="contact-subject" class="mb-1.5 block text-sm font-medium">Subject</label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              maxlength="200"
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Project inquiry"
            />
          </div>
          <div>
            <label for="contact-message" class="mb-1.5 block text-sm font-medium">Message</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              maxlength="4000"
              class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              placeholder="Tell me about your project..."
            ></textarea>
          </div>
          <!-- Honeypot anti-spam: oculto para humanos, los bots lo rellenan -->
          <div class="hidden" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button
            type="submit"
            class="inline-flex h-10 w-full items-center justify-center rounded-md bg-silver px-8 text-sm font-medium text-black shadow transition-all duration-300 hover:bg-silver/80 hover:shadow-lg"
          >
            Send Message
          </button>
          <p id="form-status" class="hidden text-center text-sm"></p>
        </form>
      </div>

      <!-- Direct Contact Cards -->
      <div class="flex flex-col gap-6">
        <p class="text-sm text-muted-foreground">Or reach out directly:</p>
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.icon !== "mail" ? "_blank" : undefined}
              rel={link.icon !== "mail" ? "noopener noreferrer" : undefined}
              class="group flex items-center gap-4 rounded-xl border bg-card p-6 text-card-foreground shadow transition-all duration-300 hover:shadow-lg hover:border-silver/50"
            >
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-silver/10">
                {link.icon === "mail" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-silver"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                )}
                {link.icon === "whatsapp" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-silver"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" x2="12.01" y1="17" y2="17" /></svg>
                )}
                {link.icon === "linkedin" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-silver"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
                )}
              </div>
              <div>
                <div class="font-semibold">{link.label}</div>
                <p class="text-sm text-muted-foreground group-hover:text-silver transition-colors">{link.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");
    if (!form || !status) return;

    // Prefill subject from CTA links like /#contact?interest=odoo-implementation
    const interest = new URLSearchParams(window.location.search).get("interest");
    if (interest) {
      const subjectInput = form.elements.namedItem("subject") as HTMLInputElement | null;
      if (subjectInput && !subjectInput.value) subjectInput.value = interest;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const data = Object.fromEntries(new FormData(form));

      status.textContent = "Sending...";
      status.className = "text-center text-sm text-muted-foreground mt-2";
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!res.ok) {
          const err = (await res.json().catch(() => null)) as { error?: string } | null;
          throw new Error(err?.error || "Something went wrong.");
        }

        status.textContent = "Message sent! I'll get back to you soon.";
        status.className = "text-center text-sm text-silver mt-2";
        form.reset();
      } catch (err) {
        status.textContent =
          err instanceof Error ? err.message : "Could not send the message. Please try again.";
        status.className = "text-center text-sm text-red-400 mt-2";
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>
