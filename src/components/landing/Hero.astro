---
import { profile } from "../../data/profile";
---

<section class="relative overflow-hidden py-20 md:py-32">
  <!-- Decorative background -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <canvas id="hero-network" class="absolute inset-0 h-full w-full"></canvas>
    <div
      class="absolute -top-40 -right-40 h-[500px] w-[500px] rounded-full bg-silver/5 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-40 h-[400px] w-[400px] rounded-full bg-silver/10 blur-3xl"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-silver/5 to-transparent blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-8">
    <div
      class="flex flex-col items-center gap-10 md:flex-row md:items-start md:gap-16"
    >
      <!-- Photo -->
      <div class="shrink-0 md:mt-16">
        <div
          class="relative h-48 w-48 overflow-hidden rounded-full border-2 border-silver/30 shadow-lg shadow-silver/10 md:h-64 md:w-64"
        >
          <img
            src="/myPhoto/mySelf.png"
            alt={`Photo of ${profile.name}`}
            class="h-full w-full object-cover object-top"
            loading="eager"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="text-center md:text-left">
        <h1
          class="text-4xl font-bold tracking-tight text-foreground md:text-5xl lg:text-6xl"
        >
          {profile.name}
        </h1>

        <p class="mt-3 text-xl font-medium text-silver md:text-2xl">
          {profile.headline}
        </p>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
          {profile.about}
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4 md:justify-start">
          <a
            href={profile.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-silver px-8 text-sm font-medium text-black shadow transition-all duration-300 hover:bg-silver/80 hover:shadow-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
          >
            Schedule a Consultation
          </a>
          <a
            href="/portfolio"
            class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-input bg-background px-8 text-sm font-medium shadow-sm transition-all duration-300 hover:bg-accent hover:text-accent-foreground hover:shadow-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
          >
            View My Work
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById("hero-network") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");
  const section = canvas?.closest("section");

  if (canvas && ctx && section) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const NUM_POINTS = 35;
    const MAX_DIST = 140;
    const SPEED = 0.15;
    const COLOR = "192, 192, 192"; // silver

    type Point = { x: number; y: number; vx: number; vy: number };
    let points: Point[] = [];
    let width = 0;
    let height = 0;
    let running = false;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      width = rect.width;
      height = rect.height;
    };

    const init = () => {
      points = Array.from({ length: NUM_POINTS }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * SPEED * 2,
        vy: (Math.random() - 0.5) * SPEED * 2,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      for (const p of points) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${COLOR}, 0.55)`;
        ctx.fill();
      }

      for (let i = 0; i < points.length; i++) {
        for (let j = i + 1; j < points.length; j++) {
          const dx = points[i].x - points[j].x;
          const dy = points[i].y - points[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DIST) {
            const opacity = (1 - dist / MAX_DIST) * 0.3;
            ctx.strokeStyle = `rgba(${COLOR}, ${opacity})`;
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(points[i].x, points[i].y);
            ctx.lineTo(points[j].x, points[j].y);
            ctx.stroke();
          }
        }
      }

      if (running) requestAnimationFrame(draw);
    };

    const start = () => {
      if (running || prefersReducedMotion) return;
      running = true;
      requestAnimationFrame(draw);
    };

    const stop = () => {
      running = false;
    };

    resize();
    init();

    if (prefersReducedMotion) {
      draw();
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) start();
          else stop();
        },
        { threshold: 0 },
      );
      observer.observe(section);
    }

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        init();
      }, 150);
    });
  }
</script>
