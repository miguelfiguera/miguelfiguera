# Dolibarr ERP/CRM (variables leídas en runtime por el servidor SSR)
DOLIBARR_URL=https://your-dolibarr-instance.com
DOLIBARR_API_KEY=your-api-key-here

# Atribución de origen (opcionales — defaults alineados con PLAN-DOLIBARR.md)
# Tag textual para note_private y ref_ext:
DOLIBARR_SOURCE_TAG=MDEV
# ID de la categoría de terceros `mdev` en Dolibarr:
DOLIBARR_CATEGORY_ID=3
